# ======================================================================
# SAAS Cabañas - Variables de Entorno (Netlify & Local)
# ======================================================================

# --- Variables Públicas (Accesibles por el navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
NEXT_PUBLIC_DEFAULT_BLUE_USD=1285

# --- Variables Privadas (Servidor / Netlify Functions / SSR - NUNCA expuestas al cliente) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-only-for-backend-admin

# Telegram Bot API (Para notificaciones instantáneas de interesados y alertas operativas)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_NOTIFICATION_CHAT_ID=your-group-or-admin-chat-id
TELEGRAM_WEBHOOK_SECRET=cabanas_anto_telegram_secret

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

